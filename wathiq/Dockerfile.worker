# ─── العامل: استخراج النص + OCR (Tesseract للعربية + poppler) ────────────────
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr poppler-utils ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
# نماذج tessdata_best أدق بوضوح للعربية من نماذج حزم النظام (انظر docs/ocr.md)
RUN mkdir -p /opt/tessdata \
 && for l in ara eng osd; do \
      curl -fsSL -o /opt/tessdata/$l.traineddata https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/main/$l.traineddata; \
    done
ENV OCR_TESSDATA_DIR=/opt/tessdata
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/copy-pdf-worker.mjs scripts/
RUN npm ci
COPY . .
USER node
CMD ["npx", "tsx", "src/worker/index.ts"]
