# ─── قاعدة البيانات ─────────────────────────────────────────────────────────
# التطبيق والعامل يتصلان بدور wathiq_app (ليس مالك الجداول، بدون BYPASSRLS)
DATABASE_URL=postgresql://wathiq_app:wathiq_app_dev@localhost:5432/wathiq
# الترحيلات فقط: دور wathiq_owner
MIGRATION_DATABASE_URL=postgresql://wathiq_owner:wathiq_owner_dev@localhost:5432/wathiq
# اختياري: مخزن مفاتيح المنافسات في قاعدة مستقلة بنسخ احتياطي قصير (انظر docs/security.md)
# KEYSTORE_DATABASE_URL=postgresql://wathiq_app:...@keystore-host:5432/wathiq_keys
# KEYSTORE_MIGRATION_DATABASE_URL=postgresql://wathiq_owner:...@keystore-host:5432/wathiq_keys

# ─── التشفير ────────────────────────────────────────────────────────────────
# المفتاح الرئيسي: "kid:base64(32 بايت)". ولّده بـ: echo "k1:$(openssl rand -base64 32)"
# للتدوير: ضع المفتاح الجديد أولاً وأبقِ القديم بعده: "k2:...,k1:..."
WATHIQ_MASTER_KEYS=
SESSION_SECRET=

# ─── التخزين ────────────────────────────────────────────────────────────────
# local للتطوير، s3 لأي تخزين متوافق (MinIO أو مزود داخل السعودية)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=wathiq
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ─── OCR ────────────────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
OCR_LANGS=ara+eng
OCR_DPI=300
# مجلد نماذج tessdata_best (موصى به؛ حاوية العامل تنزّلها تلقائياً)
# OCR_TESSDATA_DIR=/opt/tessdata
OCR_PSM=3
# الصفحات بثقة أقل من هذه تُعلَّم "ثقة منخفضة"
OCR_LOW_CONFIDENCE=70
# عدد الصفحات المعالجة بالتوازي (افتراضياً = عدد الأنوية حتى 4)
# OCR_CONCURRENCY=4

MAX_UPLOAD_MB=200
WORKER_POLL_MS=1000

# دخول تجريبي بحسابات ثابتة (المراحل 1–4 فقط؛ لا تفعّله في الإنتاج)
DEV_LOGIN=true
