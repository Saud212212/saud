# ─── قاعدة البيانات ─────────────────────────────────────────────────────────
# التطبيق والعامل يتصلان بدور wathiq_app (ليس مالك الجداول، بدون BYPASSRLS)
DATABASE_URL=postgresql://wathiq_app:wathiq_app_dev@localhost:5432/wathiq
# الترحيلات فقط: دور wathiq_owner
MIGRATION_DATABASE_URL=postgresql://wathiq_owner:wathiq_owner_dev@localhost:5432/wathiq
# مخزن مفاتيح المنافسات في قاعدة مستقلة بنسخ احتياطي 72 ساعة (انظر docs/security.md).
# اختياري في التطوير، **إلزامي في الإنتاج**: التطبيق لا يُقلع بدونه أو إذا كان نفس قاعدة DATABASE_URL.
# KEYSTORE_DATABASE_URL=postgresql://wathiq_app:...@keystore-host:5432/wathiq_keys
# KEYSTORE_MIGRATION_DATABASE_URL=postgresql://wathiq_owner:...@keystore-host:5432/wathiq_keys

# ─── التشفير ────────────────────────────────────────────────────────────────
# المفتاح الرئيسي: "kid:base64(32 بايت)". ولّده بـ: echo "k1:$(openssl rand -base64 32)"
# للتدوير: ضع المفتاح الجديد أولاً وأبقِ القديم بعده: "k2:...,k1:..."
WATHIQ_MASTER_KEYS=
SESSION_SECRET=

# ─── التخزين ────────────────────────────────────────────────────────────────
# local للتطوير، s3 لأي تخزين متوافق (MinIO أو مزود داخل السعودية)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=wathiq
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ─── OCR ────────────────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
OCR_LANGS=ara+eng
OCR_DPI=300
# مجلد نماذج tessdata_best (موصى به؛ حاوية العامل تنزّلها تلقائياً)
# OCR_TESSDATA_DIR=/opt/tessdata
OCR_PSM=3
# الصفحات بثقة أقل من هذه تُعلَّم "ثقة منخفضة"
OCR_LOW_CONFIDENCE=70
# عدد الصفحات المعالجة بالتوازي (افتراضياً = عدد الأنوية حتى 4)
# OCR_CONCURRENCY=4
# أرقام الصفحات الممسوحة في التحقق: all = كلها "يحتاج مراجعة" (افتراضي)، low = الصفحات ضعيفة الثقة فقط
OCR_NUMBERS_REVIEW=all

# ─── النموذج اللغوي (المرحلة 2) ─────────────────────────────────────────────
# المفتاح للعامل فقط (التطبيق لا يستدعي النموذج)
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# نموذج/جهد لمهمة بعينها (اختياري): EXTRACT | GAPS | PROPOSAL | CLARIFICATIONS
# AI_MODEL_EXTRACT=claude-opus-5-5
AI_EFFORT=high
# AI_EFFORT_EXTRACT=high
AI_MAX_TOKENS=32000
# عدد المقاطع المحللة بالتوازي
AI_CONCURRENCY=4
# default = عند رفض النموذج للطلب يُعاد تلقائياً على نموذج آخر من جهة الخادم؛ off للتعطيل
AI_FALLBACKS=default
# للتقييم بلا كلفة: سجّل مرة ثم أعد التشغيل (التسجيلات تحتوي نص الكراسة — خارج المستودع)
# AI_RECORD_DIR=/secure/path/recordings
# AI_PROVIDER=replay
# AI_REPLAY_DIR=/secure/path/recordings

MAX_UPLOAD_MB=200
WORKER_POLL_MS=1000

# دخول تجريبي بحسابات ثابتة (المراحل 1–4 فقط). معطّل برمجياً مع NODE_ENV=production مهما كانت قيمته.
DEV_LOGIN=true
